# Medical Billing Coder backend configuration template.
# Copy to `.env` (gitignored). Never commit real secrets.

APP_NAME=Medical Billing Coder
APP_ENV=development
API_V1_PREFIX=/api/v1

# Security. Replace in any real deployment.
SECRET_KEY=change-me-32-plus-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# Database. SQLite works for local tests; PostgreSQL is the canonical deployment DB.
# DATABASE_URL=sqlite:///./mbc_dev.db
DATABASE_URL=postgresql+psycopg2://mbc:change_me@localhost:5432/mbc

# MFA encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable MFA enrollment until a key is provisioned.
MFA_ENCRYPTION_KEY=

# Audit HMAC key, kept separate from SECRET_KEY.
AUDIT_HMAC_KEY=change-me-audit-hmac

# CORS / cookie settings.
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TRUST_PROXY=false

# AI coding. Transmission is OFF unless AI_ENABLED=true AND AI_PHI_APPROVED=true.
# The "mock" provider runs locally and needs no key.
AI_ENABLED=false
AI_PROVIDER=mock
AI_PHI_APPROVED=false
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional deterministic JSON returned by the mock provider (tests/demos only).
MOCK_PROVIDER_RESPONSE=

# Background coding jobs (Celery + Redis).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CODING_MAX_RETRIES=3
CODING_TASK_TIMEOUT_SECONDS=300
CODING_RETRY_BACKOFF_BASE=2
CODING_STALE_AFTER_SECONDS=600

# Batch document ingestion (Phase 5).
STORAGE_DIR=./.storage
MAX_UPLOAD_FILE_SIZE=5242880
MAX_UPLOAD_FILES_PER_BATCH=50
MAX_UPLOAD_BATCH_SIZE=52428800
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARS=50000
MAX_CSV_ROWS=500

# Exports (Phase 6).
MAX_EXPORT_ROWS=1000

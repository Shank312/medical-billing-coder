# Root environment template for infra/docker-compose.yml.
# Copy to `.env` (gitignored) before running Docker-based development.
# These are development-only defaults; never reuse them outside local development.

# PostgreSQL (development container).
POSTGRES_USER=mbc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mbc

# Application security. Replace with real values in any non-local deployment.
SECRET_KEY=dev-secret-change-me-please
AUDIT_HMAC_KEY=dev-hmac-change-me-please
MFA_ENCRYPTION_KEY=

# AI coding — disabled by default; the mock provider runs locally with no key.
AI_ENABLED=false
AI_PROVIDER=mock
AI_PHI_APPROVED=false
